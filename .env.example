# 视觉模型 API Key（必填，请填写你自己的 Key）
DASHSCOPE_API_KEY=sk-xxx

# 视觉模型名（默认 qwen3.7-plus；其他可选：qwen3.5-omni-plus / qwen-vl-max / gpt-4o-mini）
VISION_MODEL=qwen3.7-plus

# 非千问服务时改成对应 OpenAI 兼容地址
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 图片自动压缩阈值（可选，默认值如下）
# VISION_MAX_DIM=2048
# VISION_MAX_BYTES=4194304
# VISION_QUALITY=85